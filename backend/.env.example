# Where the Anthropic-compatible API lives.
#
# Default points at the Mac-hosted LLM proxy reachable over Tailscale; the
# proxy speaks the Anthropic Messages API (/v1/messages) so @ai-sdk/anthropic
# works unchanged.
ANTHROPIC_BASE_URL=http://192.168.6.166:4000/v1

# Anthropic API key. Optional when the proxy doesn't enforce auth — leave
# blank and the SDK falls back to a placeholder (see agents/showme.ts).
ANTHROPIC_API_KEY=
