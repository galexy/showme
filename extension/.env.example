# Mastra (CopilotKit runtime) URL the side panel chats with.
# Build-time substitution by Vite — set before `pnpm build`.
#
# Containerized Chromium on this VM cannot reach localhost:4111, so the
# default points at the AgentVMs proxy that fronts the host VM's :4111.
# For a normal local browser pointed at a backend running on this machine,
# override with: VITE_BACKEND_URL=http://localhost:4111/copilotkit
VITE_BACKEND_URL=https://calm-chipmunk-49-4111.pxy.staging.agentvms.com/copilotkit
