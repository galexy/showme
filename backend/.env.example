# Where the Anthropic-compatible API lives.
#
# When pointing at LiteLLM (or any Anthropic-compatible proxy), set this to
# <proxy-url>/v1 — the SDK appends /messages to whatever you provide.
# Examples:
#   http://localhost:4000/v1                  (proxy on this machine)
#   http://192.168.6.166:4000/v1              (Mac-hosted proxy over Tailscale)
# Leave unset to use the real Anthropic API at https://api.anthropic.com.
ANTHROPIC_BASE_URL=http://192.168.6.166:4000/v1

# Required by the SDK. When ANTHROPIC_BASE_URL points at a local proxy that
# doesn't require auth, any non-empty string works (the SDK falls back to a
# placeholder if this is unset).
ANTHROPIC_API_KEY=
